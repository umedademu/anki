":"","geography":{"macroRegion":"","macroRegions":[],"regionDetail":""},"chronology":{"displayPeriod":"","sortYear":227},"stages":{"beginner":[{"id":"WHSO-8bc2845cfb1826261bc1-B01","stage":"beginner","focus":"一問一答","type":"identify","label":"一問一答","prompt":"オスマン帝国が、フランスなどの外国商人に対して関税の軽減や領事裁判権などの特権を認めた制度を何というか？","answer":"カピチュレーション","explanation":"","keywords":[],"acceptedAnswers":[],"answerNote":"","yearMnemonic":"","source":{"name":"利用者作成CSV","url":""},"hideTermUntilAnswer":true}],"reverse":[],"integrated":[]}},{"id":"WHSO-451e9a1b2ab6638277fb","datasetLabel":"世界史SO｜第21回 3 オスマン帝国","importanceRank":228,"difficultyLabel":"一問一答","category":"イスラーム世界","term":"カピチュレーションについて説明しなさい","reading":"","aliases":[],"era":"","geography":{"macroRegion":"","macroRegions":[],"regionDetail":""},"chronology":{"displayPeriod":"","sortYear":228},"stages":{"beginner":[{"id":"WHSO-451e9a1b2ab6638277fb-B01","stage":"beginner","focus":"一問一答","type":"integrated","label":"一問一答","prompt":"カピチュレーションについて説明しなさい","answer":"スレイマン1世が、ハプスブルク家に対抗するため同盟したフランスに対して、領事裁判権や免税などの特権を認めたことに始まる通商特権。のちにイギリスやオランダの商人にも与えられ、西ヨーロッパとの交易を活発化させた。","explanation":"","keywords":[],"acceptedAnswers":[],"answerNote":"","yearMnemonic":"","source":{"name":"利用者作成CSV","url":""},"hideTermUntilAnswer":true}],"reverse":[],"integrated":[]}},{"id":"WHSO-0cd6cde4b5e6e0c0a78a","datasetLabel":"世界史SO｜第21回 3 オスマン帝国","importanceRank":229,"difficultyLabel":"一問一答","category":"イスラーム世界","term":"ハプスブルク家とは何か。また、16世紀にはどの地域を支配していたか？","reading":"","aliases":[],"era":"","geography":{"macroRegion":"","macroRegions":[],"regionDetail":""},"chronology":{"displayPeriod":"","sortYear":229},"stages":{"beginner":[{"id":"WHSO-0cd6cde4b5e6e0c0a78a-B01","stage":"beginner","focus":"一問一答","type":"integrated","label":"一問一答","prompt":"ハプスブルク家とは何か。また、16世紀にはどの地域を支配していたか？","answer":"16世紀にはスペイン王位や神聖ローマ皇帝位を握り、オーストリア方面にも勢力を持っていた。","explanation":"","keywords":[],"acceptedAnswers":[],"answerNote":"","yearMnemonic":"","source":{"name":"利用者作成CSV","url":""},"hideTermUntilAns